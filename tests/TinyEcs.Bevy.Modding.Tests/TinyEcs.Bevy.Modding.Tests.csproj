<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- ONLY the lib + TinyEcs core — NO ClassicUO.Ecs. This proves the modding
       runtime is usable standalone, with no game-specific glue. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\TinyEcs\TinyEcs.csproj" />
    <ProjectReference Include="..\..\src\TinyEcs.Bevy\TinyEcs.Bevy.csproj" />
    <ProjectReference Include="..\..\src\TinyEcs.Bevy.UI\TinyEcs.Bevy.UI.csproj" />
    <ProjectReference Include="..\..\src\TinyEcs.Bevy.Modding\TinyEcs.Bevy.Modding.csproj" />
  </ItemGroup>

  <!-- Upstream Wasmtime native (core-wasm module backend) next to the test output — it
       does not flow via ProjectRef (RID-scoped). Read from the modding lib's output
       (which resolves it from the NuGet cache). Windows x64 only for now; other RIDs
       need the matching runtimes/<rid>/native name. -->
  <ItemGroup>
    <_UpstreamWasmtimeNative Include="..\..\src\TinyEcs.Bevy.Modding\bin\$(Configuration)\net10.0\wasmtime.dll" />
  </ItemGroup>
  <Target Name="CopyWasmtimeNative" AfterTargets="Build">
    <Copy SourceFiles="@(_UpstreamWasmtimeNative)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="Exists('@(_UpstreamWasmtimeNative)')" />
  </Target>

</Project>
