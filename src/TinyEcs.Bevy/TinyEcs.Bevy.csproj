<Project Sdk="Microsoft.NET.Sdk">
  <!-- A cuo guest publish (-p:WasmGuest=true) rebuilds this lib WITHOUT WASM_THREADS and
       would otherwise drop that build into the same bin the desktop client links from,
       silently swapping the parallel scheduler out of an already-built exe. Separate bin
       for guest builds. (BaseOutputPath only: BaseIntermediateOutputPath has to be set
       before the SDK props import, and obj sharing is harmless — DefineConstants are part
       of the up-to-date check, so the next build recompiles.) -->
  <PropertyGroup Condition="'$(WasmGuest)' == 'true'">
    <BaseOutputPath>$(MSBuildProjectDirectory)\bin\wasmguest\</BaseOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TinyEcs.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TinyEcs\TinyEcs.csproj" />
  </ItemGroup>

  <!-- Start Templates -->
  <ItemGroup>
    <None Update="TinyEcs.Bevy.Data.tt">
      <LastGenOutput>TinyEcs.Bevy.Data.g.cs</LastGenOutput>
      <Generator>TextTemplatingFileGenerator</Generator>
    </None>
    <None Update="TinyEcs.Bevy.Filter.tt">
      <LastGenOutput>TinyEcs.Bevy.Filter.g.cs</LastGenOutput>
      <Generator>TextTemplatingFileGenerator</Generator>
    </None>
    <None Update="TinyEcs.Bevy.SystemExtensions.tt">
      <LastGenOutput>TinyEcs.Bevy.SystemExtensions.g.cs</LastGenOutput>
      <Generator>TextTemplatingFileGenerator</Generator>
    </None>
    <None Update="TinyEcs.Bevy.Observers.tt">
      <LastGenOutput>TinyEcs.Bevy.Observers.g.cs</LastGenOutput>
      <Generator>TextTemplatingFileGenerator</Generator>
    </None>
    <None Update="TinyEcs.Bevy.SystemAdapters.tt">
      <LastGenOutput>TinyEcs.Bevy.SystemAdapters.g.cs</LastGenOutput>
      <Generator>TextTemplatingFileGenerator</Generator>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="TinyEcs.Bevy.Data.g.cs">
      <DependentUpon>TinyEcs.Bevy.Data.tt</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <Compile Update="TinyEcs.Bevy.Filter.g.cs">
      <DependentUpon>TinyEcs.Bevy.Filter.tt</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <Compile Update="TinyEcs.Bevy.SystemExtensions.g.cs">
      <DependentUpon>TinyEcs.Bevy.SystemExtensions.tt</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <Compile Update="TinyEcs.Bevy.Observers.g.cs">
      <DependentUpon>TinyEcs.Bevy.Observers.tt</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <Compile Update="TinyEcs.Bevy.SystemAdapters.g.cs">
      <DependentUpon>TinyEcs.Bevy.SystemAdapters.tt</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
  </ItemGroup>
  <!-- End Templates -->

</Project>
