<Project Sdk="Microsoft.NET.Sdk">
  <!-- Guest publishes build this lib with WASM_GUEST / MOD_RELAY_GUEST, which change
       what it compiles (no Wasmtime backend). Keep those out of the bin a desktop host
       links from, so a guest publish never leaves the desktop exe on a guest build. -->
  <PropertyGroup Condition="'$(WasmGuest)' == 'true'">
    <BaseOutputPath>$(MSBuildProjectDirectory)\bin\wasmguest\</BaseOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <!-- net10.0 only: every consumer is net10.0, and a
         single TFM avoids dragging TinyEcs/Clay/Wasmtime into net9.0 inner builds
         they never otherwise exercise. Wasmtime resolves to its net9.0 asset. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
    <RootNamespace>TinyEcs.Bevy.Modding</RootNamespace>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <!-- Guest build (-p:WasmGuest=true, a global property so it flows to this P2P
       reference): the host itself runs as a wasm component and cannot embed wasmtime,
       so every wasmtime-dotnet reference + the Component/ backend are stripped. -->
  <PropertyGroup Condition="'$(WasmGuest)' == 'true'">
    <DefineConstants>$(DefineConstants);WASM_GUEST</DefineConstants>
  </PropertyGroup>

  <!-- -p:ModRelayGuest=true (with WasmGuest): the guest relays every mod to its native
       host over abi/mod-abi.fbs (ModRelayBackend + ModAbiRunner; the host runs the real
       component mods), so it needs FlatSharp (below) but never wasmtime. -->
  <PropertyGroup Condition="'$(ModRelayGuest)' == 'true'">
    <DefineConstants>$(DefineConstants);MOD_RELAY_GUEST</DefineConstants>
  </PropertyGroup>

  <!-- FlatSharp (the ModAbi wire types + ModAbiRunner/ModRelayBackend, which speak
       them) is needed by the relay guest. Desktop compiles it too (no runtime use: a
       host may still hand ModdingConfig.WasmExecutor a relay, and the tests drive the
       runner through stub executors). A WasmGuest build without the relay has no mods. -->
  <PropertyGroup>
    <UseFlatSharp Condition="'$(WasmGuest)' != 'true' OR '$(ModRelayGuest)' == 'true'">true</UseFlatSharp>
  </PropertyGroup>

  <!-- The bridge impls + executor seams are internal. A host that drives them directly
     (its tests, a guest dispatcher/relay executor) lists its assembly names in
     TinyEcsModdingFriends (';'-separated), e.g. from its own Directory.Build.props. -->
  <ItemGroup>
    <InternalsVisibleTo Include="TinyEcs.Bevy.Modding.Tests" />
    <InternalsVisibleTo Include="$(TinyEcsModdingFriends)" Condition="'$(TinyEcsModdingFriends)' != ''" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TinyEcs\TinyEcs.csproj" />
    <ProjectReference Include="..\TinyEcs.Bevy\TinyEcs.Bevy.csproj" />
    <ProjectReference Include="..\TinyEcs.Bevy.UI\TinyEcs.Bevy.UI.csproj" />
    <ProjectReference Include="..\..\external\Clay.NET\src\Clay\Clay.csproj" />
  </ItemGroup>

  <!-- ModWasmExecutor.cs (the executor/sink seam interfaces) and ModAbiBacking.cs
       (the generic import backing + ModRelayState) have NEITHER a wasmtime nor a
       FlatSharp dependency and stay compiled everywhere. ModAbiRunner.cs +
       ModRelayBackend.cs (FlatSharp) drop out without UseFlatSharp. -->
  <ItemGroup Condition="'$(UseFlatSharp)' != 'true'">
    <Compile Remove="ModRelayBackend.cs" />
    <Compile Remove="ModAbiRunner.cs" />
  </ItemGroup>

  <!-- Mod relay ABI (FlatSharp). The canonical schema abi/mod-abi.fbs is
       ATTRIBUTE-FREE (planus rejects user attributes); FlatSharp needs an annotated
       copy, so DeriveFlatSharpSchema copies it into obj/, prepends the fs_serializer
       attribute decl, and tags the 5 boundary root tables — annotating a root pulls
       its whole graph. Generated C# lands in namespace ModAbi (from the .fbs).
       Needed by desktop AND the relay guest (see UseFlatSharp above). -->
  <ItemGroup Condition="'$(UseFlatSharp)' == 'true'">
    <PackageReference Include="FlatSharp.Compiler" Version="7.9.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FlatSharp.Runtime" Version="7.9.0" />
  </ItemGroup>

  <PropertyGroup Condition="'$(UseFlatSharp)' == 'true'">
    <CanonicalModAbiFbs>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\abi\mod-abi.fbs'))</CanonicalModAbiFbs>
    <DerivedModAbiFbs>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\obj\mod-abi.fs.fbs'))</DerivedModAbiFbs>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseFlatSharp)' == 'true'">
    <FlatSharpSchema Include="$(DerivedModAbiFbs)" />
  </ItemGroup>

  <UsingTask Condition="'$(UseFlatSharp)' == 'true'" TaskName="WriteTextFile" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Path ParameterType="System.String" Required="true" />
      <Content ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        System.IO.File.WriteAllText(Path, Content);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="DeriveFlatSharpSchema"
          Condition="'$(UseFlatSharp)' == 'true'"
          BeforeTargets="FlatSharpFbsCompile"
          Inputs="$(CanonicalModAbiFbs)"
          Outputs="$(DerivedModAbiFbs)">
    <MakeDir Directories="$(MSBuildProjectDirectory)\obj" />
    <PropertyGroup>
      <_ModAbi>$([System.IO.File]::ReadAllText('$(CanonicalModAbiFbs)'))</_ModAbi>
      <_ModAbi>$(_ModAbi.Replace('table Handshake {', 'table Handshake (fs_serializer) {'))</_ModAbi>
      <_ModAbi>$(_ModAbi.Replace('table SetupReply {', 'table SetupReply (fs_serializer) {'))</_ModAbi>
      <_ModAbi>$(_ModAbi.Replace('table SystemInput {', 'table SystemInput (fs_serializer) {'))</_ModAbi>
      <_ModAbi>$(_ModAbi.Replace('table CommandBuffer {', 'table CommandBuffer (fs_serializer) {'))</_ModAbi>
      <_ModAbi>$(_ModAbi.Replace('table ObserverInput {', 'table ObserverInput (fs_serializer) {'))</_ModAbi>
      <_ModAbi>$(_ModAbi.Replace('table SpawnedInput {', 'table SpawnedInput (fs_serializer) {'))</_ModAbi>
      <_DerivedModAbi>// AUTO-DERIVED from abi/mod-abi.fbs for FlatSharp — do not edit.
attribute &quot;fs_serializer&quot;%3B
$(_ModAbi)</_DerivedModAbi>
    </PropertyGroup>
    <WriteTextFile Path="$(DerivedModAbiFbs)" Content="$(_DerivedModAbi)" />
    <Message Text="Derived FlatSharp schema: $(DerivedModAbiFbs)" Importance="high" />
  </Target>

  <!-- Component-model (wasm32-wasip2) mod backend, Component/ComponentModBackend.cs: the
       wasmtime-dotnet fork (external/wasmtime-dotnet, branch component-model). Its
       assembly (WasmtimeCm.Dotnet) and native (wasmtime-cm.*) are renamed so it loads
       side by side with the upstream Wasmtime NuGet a host may also reference, but it
       keeps the `Wasmtime` namespace — hence the extern alias: inside this lib the fork
       is only reachable as WasmtimeCm::Wasmtime. Pre-build the fork standalone once (`dotnet build` in its
       folder) so its native download/extract step has run. Not in any guest flavour. -->
  <ItemGroup Condition="'$(WasmGuest)' != 'true'">
    <ProjectReference Include="..\..\external\wasmtime-dotnet\src\Wasmtime\Wasmtime.csproj" Aliases="WasmtimeCm" />
  </ItemGroup>
  <ItemGroup Condition="'$(WasmGuest)' == 'true'">
    <Compile Remove="Component\**" />
  </ItemGroup>

</Project>
