// Canonical mod ABI schema — core-wasm modding boundary (replaces tinyecs:modding WIT).
//
// RULES (wire contract):
// - This file is ATTRIBUTE-FREE: planus 1.3.0 rejects user attributes. The FlatSharp
//   build derives an annotated copy (prepends `attribute "fs_serializer";` and tags the
//   boundary root tables) into obj/ — never annotate here.
// - Union member order IS the wire contract (positional tags, NONE=0). Append only;
//   never reorder or insert in the middle. Same for enum values.
// - fbs `byte` is SIGNED; enums here are `ubyte`-backed on purpose.
// - Packed guest returns are `len<<32 | ptr` (u64), 0 = none — not encoded here, but
//   every table below that says "guest return" crosses that way.
//
// Guest exports (core module, see CoreWasmModBackend):
//   memory
//   mod_alloc(size: u32) -> u32          bump arena; host writes inputs here
//   mod_arena_reset()
//   mod_setup(ptr, len) -> u64           in: Handshake, out (guest return): SetupReply
//   mod_run(sys_id, ptr, len) -> u64     in: SystemInput, out: CommandBuffer or 0
//   mod_observer(obs_id, entity: u64, ptr, len) -> u64
//                                        in: ObserverInput, out: CommandBuffer or 0
//   mod_filter(arg, ptr, len) -> u32     host-tagged byte blob; nonzero = filtered
//
// Host imports are HOST-DEFINED (module name + function set): the host describes
// them as ModHostImport shape descriptors (see ModHostImports.cs) and the executor
// glue defines them into the module's import table. Mid-run RPCs only — everything
// else rides the buffers below. The generic set every executor also gets:
//   log(ptr, len)
//   entity_parent(entity: u64) -> u64        0 = none
//   entity_children(entity: u64, out_ptr, cap) -> u32   writes u64 ids; returns count
//   component_get(entity: u64, type_id: u32, out_ptr, cap) -> u32   returns needed len; 0 = absent
//   resource_get(type_id: u32, out_ptr, cap) -> u32

namespace ModAbi;

// ---------------------------------------------------------------------------
// Shared

enum Encoding : ubyte {
  Json = 0,   // data = utf8 JSON (phase 1 default; registry GetJson/SetJson)
  Typed = 1   // data = typed sub-buffer (phase 2 hot set; registry GetFlat/SetFlat)
}

// A component / resource / event payload. type_id interned via Handshake; 0xFFFF = none.
table CompValue {
  type_id: uint16;
  encoding: Encoding;
  data: [ubyte];
}

// ---------------------------------------------------------------------------
// Handshake: host -> guest, input to mod_setup

table TypePath {
  id: uint16;
  path: string;   // e.g. "game:ui/node"
}

table Handshake {
  abi_version: uint32;
  type_paths: [TypePath];   // every registered component + resource + event path
}

// ---------------------------------------------------------------------------
// SetupReply: guest return of mod_setup

enum Schedule : ubyte {
  ModStartup = 0,
  First = 1,
  PreUpdate = 2,
  Update = 3,
  PostUpdate = 4,
  Last = 5,
  Custom = 6
}

enum QueryTermKind : ubyte {
  Ref = 0,      // read; row carries the component
  Mut = 1,      // read+write; row carries the component
  With = 2,     // filter only
  Without = 3   // filter only
}

enum ParamKind : ubyte {
  Commands = 0,
  Query = 1
}

enum ObserverKind : ubyte {
  Spawn = 0,
  Despawn = 1,
  Insert = 2,
  Remove = 3,
  Custom = 4
}

table QueryTerm {
  kind: QueryTermKind;
  type_id: uint16;
}

table QueryDecl {
  terms: [QueryTerm];   // Ref/Mut declaration order == Row.comps order
}

table ParamDecl {
  kind: ParamKind;
  query: QueryDecl;   // set when kind == Query
}

table SystemDecl {
  id: uint32;             // guest-assigned; echoed back as mod_run's sys_id
  name: string;           // diagnostics only
  schedule: Schedule;
  custom_stage: string;   // set when schedule == Custom
  params: [ParamDecl];
  after: [uint32];        // system ids (ordering constraints)
  before: [uint32];
}

table ObserverDecl {
  id: uint32;             // guest-assigned; echoed back as mod_observer's obs_id
  kind: ObserverKind;
  type_id: uint16;        // Insert/Remove target; 0xFFFF otherwise
  event_name: string;     // set when kind == Custom
}

table SetupReply {
  systems: [SystemDecl];
  observers: [ObserverDecl];
  wants_filter: bool;
}

// ---------------------------------------------------------------------------
// SystemInput: host -> guest, input to mod_run (PUSH model)

table Row {
  entity: uint64;
  comps: [CompValue];   // parallel to the param's Ref/Mut terms, declaration order
}

table QueryRows {
  param_index: uint32;   // index into SystemDecl.params
  rows: [Row];
}

table SystemInput {
  sys_id: uint32;
  queries: [QueryRows];   // one per Query param, param order
  tick: uint64;           // host frame tick (guest timers)
  // resources: [CompValue];  // RESERVED — resource push optimization; pull via resource_get today
}

// ---------------------------------------------------------------------------
// CommandBuffer: guest return of mod_run / mod_observer
//
// Entity refs are int64: >= 0 real ecs id; < 0 temp ref, index = -(v) - 1 into the
// temp-id space established by SpawnCmd.temp_id entries of THIS buffer.
// Writes are applied by the host AFTER the guest call returns — a component written
// here is NOT visible to a component_get later in the same call.

table SpawnCmd {
  temp_id: uint32;        // guest-chosen, unique within this buffer
  comps: [CompValue];
}

table InsertCmd {         // insert or overwrite components (covers component.set)
  entity: int64;
  comps: [CompValue];
}

table RemoveCmd {
  entity: int64;
  type_ids: [uint16];
}

table DespawnCmd {
  entity: int64;
}

table AddChildCmd {
  parent: int64;
  child: int64;
  index: uint32;          // 0xFFFFFFFF = append
}

table ResourceSetCmd {
  value: CompValue;
}

table EmitEventCmd {
  event_name: string;
  entity: uint64;
  data: [ubyte];          // utf8 JSON event payload
}

table ConsumeMouseCmd {
  button: ubyte;
}

table ConsumeKeyCmd {
  key: uint32;
}

// Append-only. NONE=0, SpawnCmd=1, InsertCmd=2, RemoveCmd=3, DespawnCmd=4,
// AddChildCmd=5, ResourceSetCmd=6, EmitEventCmd=7, ConsumeMouseCmd=8, ConsumeKeyCmd=9.
union Cmd {
  SpawnCmd,
  InsertCmd,
  RemoveCmd,
  DespawnCmd,
  AddChildCmd,
  ResourceSetCmd,
  EmitEventCmd,
  ConsumeMouseCmd,
  ConsumeKeyCmd
}

table CommandBuffer {
  cmds: [Cmd];
}

// ---------------------------------------------------------------------------
// ObserverInput: host -> guest, input to mod_observer

table ObserverInput {
  obs_id: uint32;
  entity: uint64;
  value: CompValue;   // insert/remove: component payload; spawn/despawn: none; custom: event json
}

root_type CommandBuffer;
