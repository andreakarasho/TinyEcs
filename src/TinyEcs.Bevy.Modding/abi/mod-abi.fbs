// Canonical mod ABI schema — the ECS half of the wasm32-wasip1 (core module) mod target.
// The same contract as abi/tinyecs-mod.wit, carried as FlatBuffers. Host functions
// outside the ECS do NOT ride this schema: they go through the `env.mod_call` JSON
// import (ModHostFunctions).
//
// RULES (wire contract):
// - This file is ATTRIBUTE-FREE: planus 1.3.0 rejects user attributes. The FlatSharp
//   build derives an annotated copy (prepends `attribute "fs_serializer";` and tags the
//   boundary root tables) into obj/ — never annotate here.
// - Union member order IS the wire contract (positional tags, NONE=0). Append only;
//   never reorder or insert in the middle. Same for enum values and table fields.
// - fbs `byte` is SIGNED; enums here are `ubyte`-backed on purpose.
// - Packed guest returns are `len<<32 | ptr` (u64), 0 = none — not encoded here, but
//   every table below that says "guest return" crosses that way.
//
// Guest exports (core module):
//   memory
//   mod_alloc(size: u32) -> u32          bump arena; host writes inputs here
//   mod_arena_reset()
//   mod_setup(ptr, len) -> u64           in: Handshake, out (guest return): SetupReply
//   mod_run(sys_id, ptr, len) -> u64     in: SystemInput, out: CommandBuffer or 0
//   mod_observer(obs_id, entity: u64, ptr, len) -> u64
//                                        in: ObserverInput, out: CommandBuffer or 0.
//                                        A Packet observer runs synchronously inside
//                                        ModPacketChain; its verdict rides the returned
//                                        CommandBuffer (0 = pass).
//   mod_spawned(ptr, len)                in: SpawnedInput, no return. Called right after
//                                        the host applies a CommandBuffer that contained
//                                        >= 1 SpawnCmd, so the guest can map its temp ids
//                                        onto real ecs ids.
//
// Host imports: `env.mod_call(name_ptr, name_len, args_ptr, args_len) -> u64` only —
// name = UTF-8 "<package>/<interface>#<function>", args = UTF-8 JSON array; returns 0
// for no result, else len<<32|ptr of UTF-8 JSON in the arena (mod_alloc). Unknown
// name / malformed args = trap. Everything ECS rides the buffers below — a mod reads
// only what its system parameters declared.

namespace ModAbi;

// ---------------------------------------------------------------------------
// Shared

enum Encoding : ubyte {
  Json = 0,   // data = utf8 JSON
  Typed = 1   // RESERVED (no host support)
}

// A component / resource / event payload. type_id interned via Handshake; 0xFFFF = none.
table CompValue {
  type_id: uint16;
  encoding: Encoding;
  data: [ubyte];
}

// ---------------------------------------------------------------------------
// Handshake: host -> guest, input to mod_setup

table TypePath {
  id: uint16;
  path: string;   // e.g. "game:ui/node"
}

table Handshake {
  abi_version: uint32;
  type_paths: [TypePath];   // every registered component + resource + event path
}

// ---------------------------------------------------------------------------
// SetupReply: guest return of mod_setup

enum Schedule : ubyte {
  ModStartup = 0,
  First = 1,
  PreUpdate = 2,
  Update = 3,
  PostUpdate = 4,
  Last = 5,
  Custom = 6
}

enum QueryTermKind : ubyte {
  Ref = 0,      // read; row carries the component
  Mut = 1,      // read+write; row carries the component
  With = 2,     // filter only
  Without = 3,  // filter only
  // Read + change-filter: the row carries the component (like Ref) AND the entity only
  // matches when the component changed since this system's last run.
  Changed = 4,
  // Read + added-filter: the row carries the component AND the entity only matches
  // when it got the component since this system's last run.
  Added = 5
}

enum ParamKind : ubyte {
  Commands = 0,
  Query = 1,
  Res = 2,      // read-only resource, ParamDecl.type_id
  ResMut = 3,   // writable resource (written back with ResourceSetCmd)
  Events = 4    // event reader: the events of ParamDecl.type_id since the last run
}

enum ObserverKind : ubyte {
  Spawn = 0,
  Despawn = 1,
  Insert = 2,   // tinyecs-mod `on-add`
  Remove = 3,   // tinyecs-mod `on-remove`
  Custom = 4,   // tinyecs-mod `on-event`; event_name = the event's type path
  Packet = 5    // tinyecs-mod `on-packet`; ObserverDecl.packet_direction / packet_ids
}

enum PacketDirection : ubyte {
  Incoming = 0,
  Outgoing = 1
}

enum PacketVerdict : ubyte {
  Pass = 0,
  Block = 1,
  Replace = 2   // CommandBuffer.replacement
}

table QueryTerm {
  kind: QueryTermKind;
  type_id: uint16;
}

table QueryDecl {
  terms: [QueryTerm];   // reading terms (Ref/Mut/Changed/Added) order == Row.comps order
}

table ParamDecl {
  kind: ParamKind;
  query: QueryDecl;   // set when kind == Query
  type_id: uint16;    // set when kind == Res / ResMut / Events
}

table SystemDecl {
  id: uint32;             // guest-assigned; echoed back as mod_run's sys_id
  name: string;           // diagnostics only
  schedule: Schedule;
  custom_stage: string;   // set when schedule == Custom
  params: [ParamDecl];
  after: [uint32];        // system ids (ordering constraints)
  before: [uint32];
  interval_ms: uint32;    // DEPRECATED (unused by the v3 SDK)
}

table ObserverDecl {
  id: uint32;             // guest-assigned; echoed back as mod_observer's obs_id
  kind: ObserverKind;
  type_id: uint16;        // Insert/Remove target; 0xFFFF otherwise
  event_name: string;     // set when kind == Custom
  params: [ParamDecl];    // the observer's parameters after the trigger
  packet_direction: PacketDirection;   // Packet only
  packet_ids: [ubyte];    // Packet only: the message ids (byte 0) it sees; empty = every id
}

table SetupReply {
  systems: [SystemDecl];
  observers: [ObserverDecl];
  wants_filter: bool;       // DEPRECATED (packets.intercept replaces it)
  wants_filter_out: bool;   // DEPRECATED
  res_unchanged: bool;      // the guest keeps each Res param's last value (ResValue.unchanged)
}

// ---------------------------------------------------------------------------
// SystemInput: host -> guest, input to mod_run (PUSH model)

table Row {
  entity: uint64;
  comps: [CompValue];   // parallel to the param's reading terms, declaration order
}

table QueryRows {
  param_index: uint32;   // index into SystemDecl.params
  rows: [Row];
}

// One Res / ResMut param. `value` absent = the host has no such resource right now —
// unless `unchanged` is set: then the value is byte-identical to the one this param of
// this system / observer received on its previous run, and the guest reuses that. The
// host only sends `unchanged` to a mod whose SetupReply set `res_unchanged`.
table ResValue {
  param_index: uint32;
  value: CompValue;
  unchanged: bool;
}

// One Events param: the events of that type sent since this system's last run.
table EventValues {
  param_index: uint32;
  values: [CompValue];
}

table SystemInput {
  sys_id: uint32;
  queries: [QueryRows];      // one per Query param, param order
  tick: uint64;              // host frame tick
  resources: [ResValue];     // one per Res / ResMut param, param order
  events: [EventValues];     // one per Events param, param order
}

// ---------------------------------------------------------------------------
// CommandBuffer: guest return of mod_run / mod_observer
//
// Entity refs are int64: >= 0 real ecs id; < 0 temp ref, index = -(v) - 1 into the
// temp-id space established by SpawnCmd.temp_id entries of THIS buffer.
// Writes are applied by the host AFTER the guest call returns.

table SpawnCmd {
  temp_id: uint32;        // guest-chosen, unique within this buffer
  comps: [CompValue];
}

table InsertCmd {         // insert or overwrite components (covers Mut write-back)
  entity: int64;
  comps: [CompValue];
}

table RemoveCmd {
  entity: int64;
  type_ids: [uint16];
}

table DespawnCmd {
  entity: int64;
}

// DEPRECATED: a host expresses hierarchy as a component. Kept for the union tag.
table AddChildCmd {
  parent: int64;
  child: int64;
  index: uint32;
}

table ResourceSetCmd {
  value: CompValue;
}

table EmitEventCmd {
  event_name: string;     // the event's type path
  entity: uint64;
  data: [ubyte];          // utf8 JSON event payload
}

// DEPRECATED: a host expresses input consumption as a request event. Kept for the union tags.
table ConsumeMouseCmd {
  button: ubyte;
}

table ConsumeKeyCmd {
  key: uint32;
}

// Append-only. NONE=0, SpawnCmd=1, InsertCmd=2, RemoveCmd=3, DespawnCmd=4,
// AddChildCmd=5, ResourceSetCmd=6, EmitEventCmd=7, ConsumeMouseCmd=8, ConsumeKeyCmd=9.
union Cmd {
  SpawnCmd,
  InsertCmd,
  RemoveCmd,
  DespawnCmd,
  AddChildCmd,
  ResourceSetCmd,
  EmitEventCmd,
  ConsumeMouseCmd,
  ConsumeKeyCmd
}

table CommandBuffer {
  cmds: [Cmd];
  verdict: PacketVerdict;   // Packet observers only; ignored elsewhere
  replacement: [ubyte];     // verdict == Replace: the bytes to forward instead
}

// ---------------------------------------------------------------------------
// ObserverInput: host -> guest, input to mod_observer

table ObserverInput {
  obs_id: uint32;
  entity: uint64;
  value: CompValue;          // insert/remove: component payload; custom: event json
  queries: [QueryRows];      // the observer's params (ObserverDecl.params), as SystemInput
  resources: [ResValue];
  events: [EventValues];
  packet_direction: PacketDirection;   // Packet observers: the message, full wire bytes,
  packet: [ubyte];                     // id first (value is absent)
}

// ---------------------------------------------------------------------------
// SpawnedInput: host -> guest, input to mod_spawned.

table SpawnResolved {
  temp_id: uint32;        // the SpawnCmd.temp_id from the buffer just applied
  entity: uint64;         // the real ecs id the host spawned
}

table SpawnedInput {
  spawned: [SpawnResolved];
}

root_type CommandBuffer;
