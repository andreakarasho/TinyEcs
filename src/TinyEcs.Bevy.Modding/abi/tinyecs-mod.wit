/// The ECS a mod sees: a Bevy-style App you add systems and observers to, and the
/// system parameters those run with (commands, queries, resources, events).
///
/// Everything in the world is named by a type path ("game:ent/graphic") and carried
/// as JSON text. The host decides which paths exist; a mod only uses them.
///
/// A mod is a wasm32-wasip2 component of its OWN world, which includes `guest` below
/// and exports one function per system it declares in `setup`:
///
///     world my-mod {
///         use tinyecs:modding/ecs@0.1.0.{commands, query, res, events, trigger-data, packet-direction, verdict};
///         export spin: func(q: query, commands: commands);
///         export on-click: func(trigger: trigger-data);
///         export filter: func(direction: packet-direction, packet: list<u8>) -> verdict;
///         include tinyecs:modding/guest@0.1.0;
///     }
///
/// The host calls the export named like the system, passing the system's parameters
/// as typed arguments in the order they were added:
///   - a scheduled system:   func(<params>)
///   - an observer:          func(trigger: trigger-data, <params>)
///   - an on-packet observer: func(direction: packet-direction, packet: list<u8>, <params>) -> verdict
/// where `add-commands` -> `commands`, `add-query` -> `query`, `add-res` / `add-res-mut`
/// -> `res`, `add-events` -> `events`. A declared system without a matching export
/// fails the mod's load.
package tinyecs:modding@0.1.0;

interface ecs {
    /// Names a host component, resource or event, e.g. "game:ent/graphic".
    type type-path = string;

    /// A value as JSON text.
    type json = string;

    /// An entity id. Valid as soon as `commands.spawn` returns it.
    type entity = u64;

    /// Components to spawn or insert, as (type path, value) pairs.
    type bundle = list<tuple<type-path, json>>;

    /// When a system runs, every frame, in this order. `startup` runs once, after the
    /// mod is loaded.
    enum schedule {
        startup,
        first,
        pre-update,
        update,
        post-update,
        last,
    }

    /// One part of a query. `ref` / `mut` / `changed` / `added` read the component
    /// (value index = their order among these four); `with` / `without` only filter.
    variant term {
        /// Read the component.
        %ref(type-path),
        /// Read the component; the system may write it back with `query.set`.
        mut(type-path),
        /// The entity must have the component.
        %with(type-path),
        /// The entity must not have the component.
        without(type-path),
        /// Read the component; only entities where it changed since this system's
        /// last run.
        changed(type-path),
        /// Read the component; only entities that got it since this system's last
        /// run.
        added(type-path),
    }

    /// Which way a packet travels.
    enum packet-direction {
        /// Into the app (e.g. server to client).
        incoming,
        /// Out of the app (e.g. client to server).
        outgoing,
    }

    /// The packets an `on-packet` observer sees: one direction, and the packet ids
    /// (byte 0 of the packet) it cares about. No ids = every packet.
    record packet-filter {
        direction: packet-direction,
        ids: list<u8>,
    }

    /// What an `on-packet` observer decides.
    variant verdict {
        /// Let it through unchanged.
        pass,
        /// Drop it.
        block,
        /// Let these bytes through instead.
        replace(list<u8>),
    }

    /// What wakes an observer.
    variant trigger {
        /// The component was added to an entity.
        on-add(type-path),
        /// The component was removed from an entity (or the entity despawned).
        on-remove(type-path),
        /// The event was sent.
        on-event(type-path),
        /// A packet matching the filter is about to be handled (incoming) or sent
        /// (outgoing). Runs through `observe-packet`, before the host acts on it.
        /// Observers run in mod load order, then declaration order; each sees the
        /// previous one's replacement, and a block stops the chain. A packet a mod
        /// sent itself skips that mod's observers.
        on-packet(packet-filter),
    }

    /// A system, declared in `setup`. Name it, list its parameters in order, then add
    /// it to a schedule (or use it as an observer).
    resource system {
        /// The name of the mod's export that implements this system (kebab-case, as in
        /// the mod's world: "spin-cube" -> `export spin-cube: func(...)`).
        constructor(name: string);

        /// Adds a `commands` parameter.
        add-commands: func();

        /// Adds a `query` parameter.
        add-query: func(terms: list<term>);

        /// Adds a read-only resource parameter.
        add-res: func(path: type-path);

        /// Adds a writable resource parameter.
        add-res-mut: func(path: type-path);

        /// Adds an event reader parameter: the events of that type sent since this
        /// system's last run.
        add-events: func(path: type-path);

        /// Runs this system after `other` (same schedule).
        after: func(other: borrow<system>);

        /// Runs this system before `other` (same schedule).
        before: func(other: borrow<system>);

        /// Skip a run when nothing it reads changed: every resource parameter is
        /// unchanged since its previous run, no event arrived, and every query
        /// matched no rows (only queries with `changed` / `added` terms can be
        /// empty on an idle frame, so a plain query keeps the system running). A
        /// system without parameters always runs. Off by default: timers and
        /// state machines driven by the mod's own state must keep running.
        run-on-change: func();
    }

    /// Passed to `setup`: where systems and observers are registered.
    resource app {
        add-systems: func(schedule: schedule, systems: list<borrow<system>>);

        /// Calls `system`'s export each time `trigger` fires.
        add-observer: func(trigger: trigger, system: borrow<system>);
    }

    /// Structural changes, applied after the system returns, in order.
    resource commands {
        /// Spawns an entity with these components and returns its id.
        spawn: func(bundle: bundle) -> entity;

        /// Adds or overwrites components.
        insert: func(entity: entity, bundle: bundle);

        /// Removes components.
        remove: func(entity: entity, types: list<type-path>);

        /// Despawns the entity and its children.
        despawn: func(entity: entity);

        /// Sends an event (observers fire, event readers see it next).
        send: func(event: type-path, value: json);

        /// Sets a writable resource. No `add-res-mut` parameter needed.
        set-resource: func(path: type-path, value: json);
    }

    /// One matching entity: the values of the reading terms (`ref` / `mut` /
    /// `changed` / `added`), in their declaration order.
    record row {
        entity: entity,
        values: list<json>,
    }

    /// The entities matching a query.
    resource query {
        /// Every matching row, in one call.
        rows: func() -> list<row>;

        /// Writes the n-th reading term of `entity` back. Traps unless that term is
        /// `mut`. Deferred like `commands`: applied after the system returns, in order
        /// with its commands (`rows` is a snapshot and does not see the write).
        set: func(entity: entity, index: u8, value: json);
    }

    /// A resource parameter.
    resource res {
        /// None when the host has no such resource right now.
        get: func() -> option<json>;

        /// True when the value equals the one this parameter received on this
        /// system's previous run: a value parsed then can be reused instead of
        /// calling `get`.
        unchanged: func() -> bool;

        /// Traps unless declared with `add-res-mut`.
        set: func(value: json);
    }

    /// An event reader parameter.
    resource events {
        read: func() -> list<json>;
    }

    /// What woke an observer: the entity (0 for events) and the component / event
    /// value.
    record trigger-data {
        entity: entity,
        value: json,
    }
}

/// What every mod implements; a mod's own world includes it and adds one export per
/// system (see the top of this file).
world guest {
    import ecs;
    use ecs.{app};

    /// Called once when the mod loads: declare systems and observers here.
    export setup: func(app: app);
}
